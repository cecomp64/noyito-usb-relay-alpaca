[Unit]
Description=NOYITO USB Relay Alpaca server
After=network-online.target
Wants=network-online.target

[Service]
User=csvensson
Group=plugdev
WorkingDirectory=/home/csvensson/noyito-usb-relay-alpaca
ExecStart=/home/csvensson/noyito-usb-relay-alpaca/.venv/bin/python -m noyito_alpaca -c config.toml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
